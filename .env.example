# Copy to .env and fill in. Never commit .env.

# ── Groq (reasoning engine, gpt-oss) ───────────────────
GROQ_API_KEY=
GROQ_MODEL=
# Separate key used ONLY by evals (LLM judge) so eval runs never exhaust the production key
JUDGE_GROQ=

# ── Portkey LLM gateway ──────────────────────────────────
PORTKEY_API_KEY=
# Provider slugs from the Portkey dashboard (the "rag" and "brag" in @rag/model)
GROQ_SLUG=
GROQ_SLUG_2=

# ── OpenAI (embeddings) ──────────────────────────────────
OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Qdrant vector DB ─────────────────────────────────────
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
QDRANT_COLLECTION_NAME=
# Minimum similarity score for a chunk to count as relevant (0-1)
# RETRIEVAL_MIN_SCORE=0.2

# ── API ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SQLite file for conversation memory
# CHAT_DB_PATH=chat_memory.db

# ── Observability ────────────────────────────────────────
LOGFIRE_TOKEN=
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ── Evals ────────────────────────────────────────────────
# EVAL_API_URL=http://localhost:8000/query

# Groq model that classifies each message at the guardrail gate (must be enabled for GROQ_API_KEY)
GUARDRAILS_MODEL=openai/gpt-oss-safeguard-20b

# Portkey saved config id (pc-...). Create it in Portkey > Configs using the JSON in app/gateway/client.py
PORTKEY_CONFIG=

# Browser-reachable API URL, baked into the frontend image at build time (Docker only)
# NEXT_PUBLIC_API_URL=http://localhost:8000
